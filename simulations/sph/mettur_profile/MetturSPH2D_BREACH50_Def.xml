<?xml version="1.0" encoding="UTF-8" ?>
<case>

    <casedef>

        <constantsdef>

            <gravity x="0" y="0" z="-9.81"
                comment="Gravitational acceleration"
                units_comment="m/s^2" />

            <rhop0 value="1000"
                comment="Reference density"
                units_comment="kg/m^3" />

            <rhopgradient value="2" />

            <hswl value="134.849151" auto="false" />

            <gamma value="7" />

            <speedsystem value="0" auto="true" />

            <coefsound value="20" />

            <speedsound value="0" auto="true" />

            <coefh value="1.0" />

            <_hdp value="2" />

            <cflnumber value="0.2" />

        </constantsdef>

        <mkconfig boundcount="240" fluidcount="9" />

        <geometry>

            <definition dp="10.0"
                units_comment="metres (m)">

                <pointref x="0" y="0" z="0" />

                <pointmin x="-10" y="-100" z="-10" />

                <pointmax x="3010" y="100" z="144.849151" />

            </definition>

            <commands>

                <mainlist>

                    <!-- ================================================= -->
                    <!-- METTUR DEM-DERIVED BED                           -->
                    <!-- ================================================= -->

                    <setdrawmode mode="full" />

                    <setmkbound mk="0" />

                    <drawfilecsv
                        file="mettur_sph_bathymetry.csv"
                        mode="bathymetry" />


                    <!-- ================================================= -->
                    <!-- INITIAL RESERVOIR                                 -->
                    <!-- ================================================= -->

                    <setmkfluid mk="0" />

                    <drawbox>

                        <boxfill>solid</boxfill>

                        <point
                            x="0"
                            y="-50"
                            z="0" />

                        <size
                            x="500"
                            y="100"
                            z="134.849151" />

                    </drawbox>


                    <!-- ================================================= -->
                    <!-- CHANNEL BED + SIDE BOUNDARIES                    -->
                    <!-- ================================================= -->

                    <setmkbound mk="0" />

                    <drawbox>

                        <boxfill>
                            bottom | left | right | front | back
                        </boxfill>

                        <point
                            x="0"
                            y="-50"
                            z="0" />

                        <size
                            x="3000"
                            y="100"
                            z="134.849151" />

                    </drawbox>


                    <!-- ================================================= -->
                    <!-- 50 m HYPOTHETICAL PILOT BREACH                   -->
                    <!-- ================================================= -->
                    <!--
                         Dam position:
                             X = 500 m

                         Breach opening:
                             Y = -25 m to +25 m
                             Width = 50 m

                         Lower dam section:
                             Y = -50 to -25

                         Upper dam section:
                             Y = +25 to +50

                         This is a hypothetical pilot geometry.
                         It is NOT a verified Mettur dam failure mode.
                    -->

                    <setmkbound mk="0" />


                    <!-- LOWER DAM SECTION -->

                    <drawbox>

                        <boxfill>
                            left | right | front | back | bottom
                        </boxfill>

                        <point
                            x="500"
                            y="-50"
                            z="0" />

                        <size
                            x="10"
                            y="25"
                            z="134.849151" />

                    </drawbox>


                    <!-- UPPER DAM SECTION -->

                    <drawbox>

                        <boxfill>
                            left | right | front | back | bottom
                        </boxfill>

                        <point
                            x="500"
                            y="25"
                            z="0" />

                        <size
                            x="10"
                            y="25"
                            z="134.849151" />

                    </drawbox>


                    <!-- ================================================= -->
                    <!-- NO TRANSVERSE WALL IN THE 50 m OPENING            -->
                    <!-- ================================================= -->

                    <shapeout
                        file="MetturSPH2D_BREACH50"
                        reset="true" />

                </mainlist>

            </commands>

        </geometry>

    </casedef>


    <execution>

        <parameters>

            <parameter key="SavePosDouble" value="0" />

            <parameter key="StepAlgorithm" value="1" />

            <parameter key="VerletSteps" value="40" />

            <parameter key="Kernel" value="2" />

            <parameter key="ViscoTreatment" value="1" />

            <parameter key="Visco" value="0.02" />

            <parameter key="ViscoBoundFactor" value="1" />

            <parameter key="DensityDT" value="2" />

            <parameter key="DensityDTvalue" value="0.1" />

            <parameter key="Shifting" value="0" />

            <parameter key="ShiftCoef" value="-2" />

            <parameter key="ShiftTFS" value="0" />

            <parameter key="RigidAlgorithm" value="1" />

            <parameter key="FtPause" value="0.0" />

            <parameter key="CoefDtMin" value="0.05" />

            <parameter key="DtIni" value="0" />

            <parameter key="DtMin" value="0" />

            <parameter key="DtFixed" value="0" />

            <parameter key="DtFixedFile" value="NONE" />

            <parameter key="DtAllParticles" value="0" />

            <parameter key="TimeMax"
                value="5.0"
                units_comment="seconds" />

            <parameter key="TimeOut"
                value="0.2"
                units_comment="seconds" />

            <parameter key="PartsOutMax"
                value="1"
                comment="**DEPRECATED** " />

            <parameter key="RhopOutMin" value="700" />

            <parameter key="RhopOutMax" value="1300" />

            <simulationdomain
                comment="Defines domain of simulation">

                <posmin
                    x="default"
                    y="default"
                    z="default" />

                <posmax
                    x="default"
                    y="default + 0"
                    z="default + 50%" />

            </simulationdomain>

        </parameters>

    </execution>

</case>