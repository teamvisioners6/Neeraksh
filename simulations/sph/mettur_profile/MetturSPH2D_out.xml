                    <!-- =============================================== -->
                    <!-- BREACH / DAM WALL -->
                    <!-- =============================================== -->
                    <!--
                         The wall is placed at x=500 m.
                         The opening is the full 100 m channel width.
                         This is an instantaneous pilot breach.
                    -->
                    <setmkbound mk="0" />
                    <drawbox>
                        <boxfill>left | right | front | back | bottom</boxfill>
                        <point x="500" y="-50" z="0" />
                        <size x="10" y="100" z="134.849151" />
                    </drawbox>
                    <!-- =============================================== -->
                    <!-- BREACH OPENING -->
                    <!-- =============================================== -->
                    <!--
                         Remove the central dam section by creating
                         the downstream domain after the dam.
                         The pilot opening will be represented by
                         the absence of a transverse wall in the
                         flow path during the simulation.
                    -->
                    <shapeout file="MetturSPH2D" reset="true" />
                </mainlist>
            </commands>
        </geometry>
